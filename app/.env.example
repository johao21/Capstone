# Copiar a .env y completar. El archivo .env real NO se versiona.

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development

# --- Seguridad ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Fuera de API_ENV=development la API se niega a arrancar con la clave de ejemplo o con una de menos de 32 caracteres.
JWT_SECRET_KEY=cambiar-por-un-valor-generado
JWT_ALGORITHM=HS256
# Duración de la sesión sin actividad (el SRS pide 60 o menos). Con actividad, el token se renueva solo.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# Bloqueo de la cuenta tras demasiados intentos fallidos de inicio de sesión (RNF-05).
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15
# Tablero (RF-59): los grupos con menos casos que este mínimo se reúnen en "Otros". Para una demo con pocas solicitudes, bajarlo a 1.
TABLERO_MINIMO_GRUPO=5
# Probabilidad estimada (calibrada, de 0 a 1) desde la cual un fago cuenta como candidato en las brechas terapéuticas (RF-56).
UMBRAL_CANDIDATO=0.5

# --- PostgreSQL (dominio transaccional y auditoría) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sirfa
POSTGRES_USER=sirfa
POSTGRES_PASSWORD=cambiar

# --- MongoDB (análisis, anotaciones y caché de embeddings) ---
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=sirfa_analysis
MONGO_USER=sirfa
MONGO_PASSWORD=cambiar

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Pipeline genómico ---
GENOMAS_DIR=/data/genomas
ANALISIS_DIR=/data/analisis
# Plantilla del comando de Kaptive; {fasta} y {salida} se reemplazan al ejecutar.
# KAPTIVE_CMD=kaptive assembly kpsc_k {fasta} -o {salida}/resultado.tsv
# Identificación de especie con Mash. Se construye con: python -m pipeline.referencias construir
# Sin ese sketch la especie NO se verifica (se usa la declarada). Rutas por defecto en data/referencias:
# REFERENCIAS_DIR=/app/data/referencias
# MASH_SKETCH=/app/data/referencias/referencias.msh
# MASH_MAPA=/app/data/referencias/especies.tsv

# --- Modelo de predicción ---
# Carpeta con el modelo entrenado (se genera con: docker compose run --rm worker-prediction python -m ml.entrenar --registrar).
MODELO_DIR=/app/ml/models
